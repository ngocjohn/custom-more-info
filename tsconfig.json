{
  "compilerOptions": {
    "outDir": "./",
    "module": "esnext",
    "target": "ES6",
    "moduleResolution": "node",
    "lib": ["ES2019", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noImplicitAny": true,
    "removeComments": true,
    "baseUrl": "./src",
    "rootDir": "src",
    "paths": {
      "@types": ["types"],
      "@constants": ["constants"],
      "@utilities": ["utilities"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
