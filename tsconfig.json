{
  "compilerOptions": {
    "outDir": "./",
    "module": "esnext",
    "target": "es2021",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "removeComments": true,
    "baseUrl": "./src",
    "rootDir": "src",
    "allowJs": true,
    "paths": {
      "@types": ["types"],
      "@constants": ["constants"],
      "@utilities": ["utilities"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib", "dist", "build"]
}
